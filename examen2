    radio = int(input("Ingresa el radio de la circunferencia"))
    distancia = int(input("Ingresa la distancia"))
    tiempo = int(input("Ingresa el tiempo"))
    niebla_violeta = (input("entras a la niebla violeta?"))
    if niebla_violeta == "no":
        print("la superficie es", calcular_superficie(radio))
        print("la rapidez de la nave es", rapidez_nave(distancia, tiempo))
        print("la nave puede aterrizar")
    else:
        print("la nave se pierde")
